# PostgreSQL: use the connection URL supplied by your Vercel Postgres/Neon/Supabase integration.
DATABASE_URL=

# 32 random bytes encoded as exactly 64 hexadecimal characters.
JWT_SECRET=
EVIDENCE_ENCRYPTION_KEY=

# Optional for same-domain Vercel deployment. For local dev use http://localhost:5173.
FRONTEND_ORIGIN=http://localhost:5173

# Optional tuning.
PG_POOL_MAX=5
MAX_UPLOAD_MB=3.5
PORT=4000
